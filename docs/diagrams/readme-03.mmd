flowchart LR
    Plan["ResponsePlan<br/>mode, thesis, answer_points, causal_claims,<br/>uncertainty_levels, self_reflection"]
    Outline["RhetoricalOutline<br/>mode-aware section list"]
    Draft["Section drafters<br/>humanize plan fields via SurfaceRules"]
    Weave["WeaveEngine<br/>transitions, length variety, asides"]
    Budget["LengthBudgeter<br/>short / medium / long"]
    Smooth["Smoother<br/>punctuation, capitalization"]
    Validator["check_content_words<br/>FUNCTION_WORDS + STRUCTURE_CONNECTORS + plan aliases"]
    Output["utterance"]

    Plan --> Outline --> Draft --> Weave --> Budget --> Smooth --> Validator --> Output
    Validator -. "fail -> tighter rerun or composer fallback" .-> Draft
